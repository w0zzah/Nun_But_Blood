<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="522.0" prefWidth="1128.0" styleClass="root-crusade" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.nunbutblood.controllers.CrusadeController">
   <children>
         <VBox prefHeight="522.0" prefWidth="1128.0" styleClass="root-crusade">
            <StackPane prefHeight="150.0" prefWidth="200.0" VBox.vgrow="SOMETIMES">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <VBox alignment="CENTER" prefWidth="450.0" spacing="15.0" styleClass="cybersigil-border" HBox.hgrow="SOMETIMES">
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                           <Label alignment="CENTER" styleClass="subheader-label" text="THE COVENANT">
                           <VBox.margin>
                              <Insets bottom="35.0" top="25.0" />
                           </VBox.margin></Label>
                           <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll" vbarPolicy="NEVER" VBox.vgrow="SOMETIMES">
                              <FlowPane fx:id="partyContainer" alignment="TOP_CENTER" columnHalignment="CENTER" prefWrapLength="0.0" />
                           </ScrollPane>
                        <HBox.margin>
                           <Insets />
                        </HBox.margin>
                        </VBox>
                        <VBox alignment="CENTER" fillWidth="false" spacing="15.0" styleClass="cybersigil-border" HBox.hgrow="NEVER">
                        <Label fx:id="statTypeLabel" styleClass="section-label" text="statType" />
                           <VBox alignment="CENTER" spacing="10.0">
                              <StackPane fx:id="diceBox" maxHeight="200.0" maxWidth="200.0" prefHeight="150.0" prefWidth="150.0" styleClass="dice-box">
                                 <Label fx:id="diceLabel" styleClass="dice-label" text="?" />
                              </StackPane>
                              <Label fx:id="outcomeLabel" opacity="0.0" styleClass="outcome-flash" text="OUTCOME" />
                           </VBox>
                           <VBox alignment="CENTER" spacing="5.0" styleClass="section-label">
                              <HBox alignment="CENTER" spacing="10.0">
                                 <Label text="LAST ROLL:" />
                                 <Label fx:id="rollResultLabel" styleClass="section-label" text="--" />
                              </HBox>
                              <Label fx:id="narrativeLabel" styleClass="narrative-text" text="ROLL IT!" textAlignment="CENTER" wrapText="true" />
                           </VBox>
                        </VBox>
                        <VBox fx:id="demonContainer" alignment="TOP_CENTER" fillWidth="false" prefWidth="450.0" spacing="15.0" styleClass="cybersigil-border" HBox.hgrow="SOMETIMES">
                           <padding>
                              <Insets bottom="20.0" left="10.0" right="20.0" top="10.0" />
                           </padding>
                           <Label fx:id="demonName" styleClass="title-label" text="THE ADVERSARY" />
                           <ProgressBar fx:id="crusadeProgressBar" prefHeight="10.0" prefWidth="300.0" progress="1.0" styleClass="crusade-progress" />
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </StackPane>
            <HBox alignment="CENTER" styleClass="cybersigil-border">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="SOMETIMES">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                     <Label styleClass="small-label" text="BATTLE LOG" />
                     <TextArea fx:id="eventLog" editable="false" prefHeight="120.0" style="-fx-background-color: transparent;" wrapText="true">
                        <styleClass>
                           <String fx:value="event-log" />
                           <String fx:value="scroll-bar-trn" />
                        </styleClass>
                     </TextArea>
                  </VBox>
                  <Button maxWidth="1.7976931348623157E308" onAction="#giveUp" styleClass="btn-mkt" text="☠GIVE IN..." HBox.hgrow="SOMETIMES" />
               </children>
            </HBox>
         </VBox>
      <VBox fx:id="eventBox" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false" StackPane.alignment="CENTER">
         <children>
            <Label fx:id="eventQuestion" alignment="CENTER" contentDisplay="CENTER" style="-fx-font-size: 60; -fx-text-fill: -crimson;" text="Question" textAlignment="CENTER" wrapText="true" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets top="50.0" />
               </VBox.margin>
               <styleClass>
                  <String fx:value="title-label" />
                  <String fx:value="cybersigil-border" />
               </styleClass></Label>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Button fx:id="choiceBButton" alignment="CENTER" maxHeight="1.7976931348623157E308" mnemonicParsing="false" text="Button" wrapText="true">
               <padding>
                  <Insets right="15.0" />
               </padding>
               <VBox.margin>
                  <Insets bottom="45.0" />
               </VBox.margin>
               <styleClass>
                  <String fx:value="btn-mkt" />
                  <String fx:value="cybersigil-border" />
               </styleClass>
            </Button>
            <Button fx:id="choiceAButton" alignment="CENTER" maxHeight="1.7976931348623157E308" mnemonicParsing="false" text="Button" wrapText="true">
               <padding>
                  <Insets right="15.0" />
               </padding>
               <styleClass>
                  <String fx:value="btn-mkt" />
                  <String fx:value="cybersigil-border" />
               </styleClass>
            </Button>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Label fx:id="statChange" style="-fx-font-size: 60;" VBox.vgrow="SOMETIMES">
               <styleClass>
                  <String fx:value="title-label" />
                  <String fx:value="cybersigil-border" />
               </styleClass>
               <VBox.margin>
                  <Insets bottom="50.0" />
               </VBox.margin></Label>
         </children>
      </VBox>
      </children>
   </StackPane>
