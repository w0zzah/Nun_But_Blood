<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="522.0" prefWidth="1128.0" styleClass="root-crusade" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.nunbutblood.controllers.CrusadeController">
   <children>
         <VBox prefHeight="522.0" prefWidth="1128.0" styleClass="root-crusade">
            <VBox fx:id="crusadeProgress" alignment="CENTER" spacing="10.0" styleClass="cybersigil-border">
               <padding>
                  <Insets bottom="10.0" top="20.0" />
               </padding>
               <children>
                  <Label styleClass="header-label" text="CURRENT EXPEDITION PROGRESS" />
                  <ProgressBar fx:id="crusadeProgressBar" maxHeight="10.0" prefHeight="20.0" prefWidth="600.0" progress="0.0" styleClass="crusade-progress" />
               </children>
            </VBox>
            <StackPane prefHeight="150.0" prefWidth="200.0" VBox.vgrow="SOMETIMES">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <VBox spacing="5.0" styleClass="cybersigil-border" HBox.hgrow="SOMETIMES">
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                           <Label styleClass="subheader-label" text="THE COVENANT" />
                           <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll" vbarPolicy="NEVER">
                              <FlowPane fx:id="partyContainer" alignment="TOP_CENTER" columnHalignment="CENTER" prefWrapLength="0.0" />
                           </ScrollPane>
                        </VBox>
                        <VBox alignment="CENTER" fillWidth="false" spacing="15.0" styleClass="cybersigil-border" HBox.hgrow="NEVER">
                           <VBox alignment="CENTER" spacing="10.0">
                              <StackPane fx:id="diceBox" maxHeight="200.0" maxWidth="200.0" prefHeight="150.0" prefWidth="150.0" styleClass="dice-box">
                                 <Label fx:id="diceLabel" styleClass="dice-label" text="?" />
                              </StackPane>
                              <Label fx:id="outcomeLabel" opacity="0.0" styleClass="outcome-flash" text="OUTCOME" />
                           </VBox>
                           <VBox alignment="CENTER" spacing="5.0" styleClass="section-label">
                              <HBox alignment="CENTER" spacing="10.0">
                                 <Label text="LAST ROLL:" />
                                 <Label fx:id="rollResultLabel" text="--">
                                    <styleClass>
                                       <String fx:value="result-value" />
                                       <String fx:value="section-label" />
                                    </styleClass>
                                 </Label>
                              </HBox>
                              <Label fx:id="narrativeLabel" styleClass="narrative-text" text="ROLL IT!" textAlignment="CENTER" wrapText="true" />
                           </VBox>
                        </VBox>
                        <VBox fx:id="demonContainer" alignment="TOP_CENTER" fillWidth="false" spacing="15.0" styleClass="cybersigil-border" HBox.hgrow="SOMETIMES">
                           <padding>
                              <Insets bottom="20.0" left="10.0" right="20.0" top="10.0" />
                           </padding>
                           <Label styleClass="subheader-label" text="THE ADVERSARY" />
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </StackPane>
            <HBox alignment="CENTER" styleClass="cybersigil-border">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="SOMETIMES">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                     <Label styleClass="small-label" text="BATTLE LOG" />
                     <TextArea fx:id="eventLog" editable="false" prefHeight="120.0" style="-fx-background-color: transparent;" wrapText="true">
                        <styleClass>
                           <String fx:value="event-log" />
                           <String fx:value="scroll-bar-trn" />
                        </styleClass>
                     </TextArea>
                  </VBox>
                  <Button maxWidth="1.7976931348623157E308" onAction="#giveUp" styleClass="btn-mkt" text="☠GIVE IN..." HBox.hgrow="SOMETIMES" />
               </children>
            </HBox>
         </VBox>
      <VBox fx:id="eventBox" alignment="CENTER" style="-fx-background-image: url(&quot;/images/background/hands.png&quot;); -fx-background-size: stretch;" visible="false" StackPane.alignment="CENTER">
         <children>
            <Label fx:id="eventQuestion" style="-fx-font-size: 70px; -fx-text-fill: -crimson;" styleClass="title-label" text="Question" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="30.0" />
               </padding></Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="SOMETIMES" />
                  <Button fx:id="choiceAButton" alignment="CENTER" mnemonicParsing="false" styleClass="btn-mkt" text="Button">
                     <padding>
                        <Insets right="15.0" />
                     </padding></Button>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="SOMETIMES" />
                  <Button fx:id="choiceBButton" alignment="CENTER" mnemonicParsing="false" styleClass="btn-mkt" text="Button" />
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="SOMETIMES" />
               </children>
            </HBox>
            <Label fx:id="statChange" style="-fx-font-size: 70;" styleClass="title-label" VBox.vgrow="SOMETIMES" />
         </children>
      </VBox>
      </children>
   </StackPane>
