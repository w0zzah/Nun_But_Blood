<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="522.0" prefWidth="1128.0" styleClass="root-crusade" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.nunbutblood.controllers.LootingController">
   <children>
      <VBox fx:id="lootingProgress" alignment="CENTER" spacing="10.0" styleClass="cybersigil-border">
         <padding>
            <Insets bottom="10.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="header-label" text="TOTAL STAMINA REMAINING" />
            <ProgressBar fx:id="lootingTotalStamina" maxHeight="10.0" prefHeight="20.0" prefWidth="600.0" progress="0.0" styleClass="crusade-progress" />
         </children>
      </VBox>
      <StackPane prefHeight="150.0" prefWidth="200.0" VBox.vgrow="SOMETIMES">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox spacing="5.0" styleClass="cybersigil-border" HBox.hgrow="SOMETIMES">
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                     <children>
                        <Label styleClass="subheader-label" text="THE COVENANT" />
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll" vbarPolicy="NEVER">
                           <content>
                              <FlowPane fx:id="partyContainer" alignment="TOP_CENTER" columnHalignment="CENTER" prefWrapLength="0.0" />
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" fillWidth="false" spacing="15.0" styleClass="cybersigil-border" HBox.hgrow="NEVER">
                     <children>
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <StackPane fx:id="diceBox" maxHeight="200.0" maxWidth="200.0" prefHeight="150.0" prefWidth="150.0" styleClass="dice-box">
                                 <children>
                                    <Label fx:id="diceLabel" styleClass="dice-label" text="?" />
                                 </children>
                              </StackPane>
                              <Label fx:id="outcomeLabel" opacity="0.0" styleClass="outcome-flash" text="OUTCOME" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" styleClass="section-label">
                           <children>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label text="LAST ROLL:" />
                                    <Label fx:id="rollResultLabel" text="--">
                                       <styleClass>
                                          <String fx:value="result-value" />
                                          <String fx:value="section-label" />
                                       </styleClass>
                                    </Label>
                                 </children>
                              </HBox>
                              <Label fx:id="narrativeLabel" styleClass="narrative-text" text="ROLL IT!" textAlignment="CENTER" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="lootingContainer" alignment="TOP_CENTER" fillWidth="false" spacing="15.0" styleClass="cybersigil-border" HBox.hgrow="SOMETIMES">
                     <padding>
                        <Insets bottom="20.0" left="10.0" right="20.0" top="10.0" />
                     </padding>
                     <children>
                        <Label styleClass="subheader-label" text="5 Stamina Each" />
                        <Button fx:id="searchCorpse" mnemonicParsing="false" text="Search Corpse" />
                        <Button fx:id="searchSurrondings" mnemonicParsing="false" text="Search Surrondings" />
                        <Button fx:id="prayForBlessing" mnemonicParsing="false" text="Pray for Blessing" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </StackPane>
      <HBox alignment="CENTER" styleClass="cybersigil-border">
         <children>
            <VBox spacing="5.0" HBox.hgrow="SOMETIMES">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <children>
                  <Label styleClass="small-label" text="Loot Found" />
                  <TextArea fx:id="lootFound" editable="false" prefHeight="120.0" style="-fx-background-color: transparent;" wrapText="true">
                     <styleClass>
                        <String fx:value="event-log" />
                        <String fx:value="scroll-bar-trn" />
                     </styleClass>
                  </TextArea>
               </children>
            </VBox>
            <Button fx:id="returnToCovenant" maxWidth="1.7976931348623157E308" styleClass="btn-mkt" text="Return to Covenant" HBox.hgrow="SOMETIMES" />
         </children>
      </HBox>
   </children>
</VBox>
