<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="seng201.nunbutblood.gui.MarketController"
            styleClass="root">
    <top>
        <VBox styleClass="title-bar" alignment="CENTER" spacing="4">
            <Label text="THE MARKET" styleClass="title-label"/>
            <Label fx:id="faithLabel" text="Faith: 300" styleClass="stat-pill"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="16" alignment="TOP_CENTER">
            <padding><Insets top="16" bottom="8" left="20" right="20"/></padding>

            <!-- Apostles for hire -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="APOSTLES FOR HIRE" styleClass="section-label"/>
                <ListView fx:id="apostleList" styleClass="apostle-list" VBox.vgrow="ALWAYS"/>
                <Button text="HIRE APOSTLE" onAction="#handleHire"
                        styleClass="glow-button" maxWidth="Infinity"/>
                <Button text="SELL APOSTLE (½ price)" onAction="#handleSellApostle"
                        styleClass="danger-btn" maxWidth="Infinity"/>
            </VBox>

            <!-- Items for sale -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="ITEMS FOR SALE" styleClass="section-label"/>
                <ListView fx:id="itemList" styleClass="apostle-list" VBox.vgrow="ALWAYS"/>
                <Button text="BUY ITEM" onAction="#handleBuy"
                        styleClass="glow-button" maxWidth="Infinity"/>
                <Button text="SELL ITEM (½ price)" onAction="#handleSellItem"
                        styleClass="danger-btn" maxWidth="Infinity"/>
            </VBox>

            <!-- Covenant inventory -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="YOUR INVENTORY" styleClass="section-label"/>
                <ListView fx:id="inventoryList" styleClass="apostle-list" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox spacing="4" alignment="CENTER">
            <padding><Insets top="4" bottom="16" left="40" right="40"/></padding>
            <Label fx:id="statusLabel" text=" " styleClass="hint-label" wrapText="true"/>
            <Button text="← BACK TO COVENANT" onAction="#handleBack"
                    styleClass="glow-button" maxWidth="Infinity"/>
        </VBox>
    </bottom>
</BorderPane>
