<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.nunbutblood.gui.MarketController">
   <children>
      <VBox alignment="CENTER" spacing="6" styleClass="cybersigil-border">
         <children>
            <HBox alignment="BASELINE_LEFT">
               <children>
                  <Label styleClass="title-label" text="Market" textFill="WHITE">
                     <effect>
                        <InnerShadow blurType="GAUSSIAN">
                           <color>
                              <Color red="0.8421052694320679" green="0.44054579734802246" blue="0.44054579734802246" />
                           </color>
                        </InnerShadow>
                     </effect>
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Label>
                  <Region HBox.hgrow="SOMETIMES" />
                  <Label fx:id="faithLabel" styleClass="section-label" text="Faith: 0" />
                  <Region HBox.hgrow="SOMETIMES" />
                  <Label fx:id="expeditionLabel" alignment="CENTER" contentDisplay="CENTER" styleClass="section-label" text="Crsuade 0/ 0" />
                  <Region HBox.hgrow="SOMETIMES" />
                  <Label fx:id="partyLabel" alignment="CENTER_RIGHT" contentDisplay="RIGHT" styleClass="section-label" text="Party: 0/5" />
               </children>
            </HBox>
         </children>
      </VBox>
      <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="cybersigil-border" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox alignment="CENTER">
               <children>
                  <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                     <tabs>
                        <Tab text="Items">
                           <content>
                              <VBox fx:id="itemPane" alignment="TOP_CENTER" spacing="20.0" styleClass="section-label">
                                 <padding>
                                    <Insets top="20.0" />
                                 </padding>
                              </VBox>
                           </content>
                        </Tab>
                        <Tab text="Saints">
                           <content>
                              <FlowPane fx:id="saintPane" hgap="10.0" prefHeight="200.0" prefWidth="200.0" styleClass="section-label" vgap="10.0">
                                 <padding>
                                    <Insets top="20.0" />
                                 </padding>
                              </FlowPane>
                           </content>
                        </Tab>
                        <Tab text="Inventory">
                           <content>
                              <VBox fx:id="inventoryPane" alignment="TOP_CENTER" spacing="20.0" styleClass="section-label" />
                           </content>
                        </Tab>
                     </tabs>
                  </TabPane>
               </children>
            </VBox>
         </content>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets left="50.0" top="50.0" />
         </padding>
      </ScrollPane>
      <VBox alignment="CENTER">
         <children>
            <Label fx:id="statusLabel" alignment="CENTER" styleClass="hint-label" wrapText="true" />
            <Button maxWidth="Infinity" onAction="#handleBack" styleClass="cybersigil-border" text="Go Back" />
         </children>
      </VBox>
   </children>
</VBox>
