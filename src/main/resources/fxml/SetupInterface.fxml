<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="root-setup" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.nunbutblood.gui.SetupController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="0">
      
               <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER">
               <StackPane alignment="TOP_CENTER" prefHeight="3.0" prefWidth="1672.0" VBox.vgrow="ALWAYS">
                  <children>
                     <VBox alignment="CENTER" StackPane.alignment="CENTER">
                        <children>
                           <HBox styleClass="cybersigil-border" VBox.vgrow="ALWAYS">
                              <children>
                                 <VBox alignment="CENTER" styleClass="form-section-part" HBox.hgrow="SOMETIMES">
                                    <children>
                                       <Label styleClass="section-label" text="COVENANT NAME" VBox.vgrow="NEVER" />
                                       <TextField fx:id="nameField" promptText="3–15 characters, letters and numbers only" styleClass="input-field" VBox.vgrow="NEVER" />
                                       <Label fx:id="nameError" styleClass="error-label" text=" " wrapText="true" />
                                    </children>
                                 </VBox>
                                 <VBox alignment="CENTER" styleClass="form-section-part" HBox.hgrow="SOMETIMES">
                                    <children>
                                       <Label styleClass="section-label" text="DIFFICULTY" />
                                       <HBox spacing="16" style="-fx-padding: 4 0;">
                                          <children>
                                             <ToggleButton fx:id="easyMode" maxWidth="Infinity" styleClass="diff-btn" text="I'm afraid" HBox.hgrow="ALWAYS" />
                                             <ToggleButton fx:id="hardMode" maxWidth="Infinity" styleClass="diff-btn" text="Hurt me plenty&#10;" HBox.hgrow="ALWAYS" />
                                          </children>
                                       </HBox>
                                       <Label fx:id="nameError1" styleClass="error-label" text=" " wrapText="true" />
                                    </children>
                                 </VBox>
                                 <VBox alignment="TOP_CENTER" spacing="6" styleClass="form-section-part" HBox.hgrow="SOMETIMES">
                                    <children>
                                       <Label styleClass="section-label" text="NUMBER OF CRUSADES" />
                                       <HBox alignment="CENTER" fillHeight="false" VBox.vgrow="NEVER">
                                          <children>
                                             <Slider fx:id="expeditionSlider" blockIncrement="1" majorTickUnit="5" max="15" min="1.0" minorTickCount="4" snapToTicks="true" value="10" HBox.hgrow="ALWAYS">
                                                <cursor>
                                                   <Cursor fx:constant="H_RESIZE" />
                                                </cursor>
                                             </Slider>
                                             <Label fx:id="expeditionValue" alignment="CENTER" contentDisplay="TOP" minWidth="30" styleClass="stat-value" text="10" />
                                          </children>
                                       </HBox>
                                       <Label fx:id="nameError2" styleClass="error-label" text=" " wrapText="true" />
                                    </children>
                                 </VBox>
                              </children>
                           </HBox>
                           <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" spacing="8" styleClass="cybersigil-border">
                              <children>
                                 <Label contentDisplay="BOTTOM" styleClass="section-label" text="CHOOSE 3 STARTING APOSTLES       " />
                                 <Label fx:id="saintSelectLabel" alignment="TOP_RIGHT" contentDisplay="RIGHT" styleClass="hint-label" text="0 / 3 selected" />
                                 <GridPane fx:id="saintsGrid" alignment="CENTER" hgap="10" styleClass="apostle-card" vgap="10" />
                                 <Label fx:id="statusLabel" styleClass="error-label" text=" " />
                              </children>
                           </VBox>
                        </children>
                     </VBox>
                     <HBox fx:id="alertBox" alignment="CENTER" opacity="0.0" style="-fx-background-color: rgba(0, 0, 0, 0.7);" visible="false" StackPane.alignment="CENTER">
                        <children>
                           <Label fx:id="statusLabel" styleClass="title-label" text="Label" />
                        </children>
                     </HBox>
                  </children>
               </StackPane>
               <Button fx:id="startButton" maxHeight="1.7976931348623157E308" maxWidth="Infinity" onAction="#handleStart" text="BEGIN THE CRUSADE" VBox.vgrow="ALWAYS">
                  <styleClass>
                     <String fx:value="glow-button" />
                     <String fx:value="cybersigil-border" />
                  </styleClass>
               </Button>
               <VBox.margin>
                  <Insets bottom="20" />
               </VBox.margin>
            </VBox>
         </ScrollPane>
      </VBox>
      <VBox fx:id="entryBox" alignment="CENTER" style="-fx-background-color: rgba(25,25,25); -fx-border-image-width: 150;" styleClass="cybersigil-border">
         <children>
            <Label style="-fx-font-size: 200;" styleClass="title-label" text="NUN' BUT BLOOD" />
            <Button fx:id="enter" mnemonicParsing="false" onAction="#enter" style="-fx-font-size: 50;" styleClass="btn-mkt" text="✟ ESTABLISH THE COVEN ✟">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin></Button>
         </children>
      </VBox>
   </children>
</StackPane>
