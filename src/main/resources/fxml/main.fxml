<?xml version="1.0" encoding="UTF-8"?>

<!-- Custom fxml until scene builder starts working properly -->
<!-- This will be redundent when i can figure out how to sudo pacman -S a will to live -->
<!-- Imports already configured nodes for each type. see ->  https://openjfx.io/javadoc/21/javafx.graphics/javafx/scene/doc-files/cssref.html#button also to import to java import javafx.scene.control.Button;-->

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Button - Can contain text + graphic. 3 modes : Normal -> Standard push button : Default -> On enter press resolve : Cancel -> On esc press resolve-->
<!-- Non-Editable text, can display text in certain area -->
<!-- Stack children on top of each other dependent on stack location. Good for crowded environments  -->
<!-- Layout children vertically, good for holding multiple labels or options, like a menu  -->
<!-- -->
<!--TODO: Address  xmlns="http://javafx.com/javafx/25" as it should pull 21 -->
<!-- Stack panes are primarily used as a container, holding 'children' in it to. l1 -->
<!-- Declare XML namespace for document(25) -> Declares second xml namespace with prefix fx. Used for elemnets that are FXML specific rather than just JAVAFX-->
<!-- Assosciates the java class with the fxml file. this uses the info to create an instance of it's Specified class. -->
<!-- Then close's each div -->

<StackPane styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.nunbutblood.gui.MainController"> <!-- Links the style.css file, pulling all of its data into the stackpane-->

      <VBox alignment="CENTER" prefHeight="605.0" prefWidth="1101.0" spacing="20" style="-fx-alignment: center;">
      <VBox alignment="CENTER" prefHeight="605.0" prefWidth="1101.0" spacing="20">
         <children> <!-- Stacks children vertically -->
               <!-- Set's the text "Nun'But Blood" to copy label format from line 8, then pulls ONLY style from style.css file-->
               <Label alignment="CENTER" prefHeight="97.0" prefWidth="585.0" styleClass="title-label" text="Nun'But Blood" />
               <!-- Set pulls defaultLabel config from MainController.java (line 20 here and line 16 in MainController) , serves as counter, -->
               <Label fx:id="defaultLabel" alignment="CENTER" text="--Establish The Covenant--">
               <font>
                  <Font name="AR PL KaitiM GB" size="34.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" style="-fx-alignment: center;" text="Covenant Name" />
            <TextField maxHeight="10.0" maxWidth="500.0" style="-fx-alignment: center; -fx-background-color: black;" styleClass="title-label" />
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label style="-fx-alignment: center;" text="Number Of Crusades" />
            <Slider maxWidth="500.0" style="-fx-alignment: center; -fx-region-background: black; -fx-skin: black;" styleClass="title-label" />
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label style="-fx-alignment: center;" text="Difficulty" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="Easy" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="hard" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label style="-fx-alignment: center;" text="Choose Your Apostles" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="1" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="2" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="3" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="4" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="5" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="6" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="7" />
                  <ToggleButton mnemonicParsing="false" style="-fx-alignment: center;" styleClass="glow-button" text="8" />
               </children>
            </HBox>
         </children>
      </VBox>

      </VBox>

</StackPane>
